# Copy these settings into server/.env. Never commit server/.env.
# Keep your existing DB_* and MINIO_* values there as well.

# Generate a random value of at least 32 characters for this secret.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=axognition-server
JWT_AUDIENCE=axognition-tablet
